{
    "name": "tic-tac-toe",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
