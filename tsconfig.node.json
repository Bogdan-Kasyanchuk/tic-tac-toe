{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [ "ES2023" ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": [ "node" ]
    },
    "include": [ "vite.config.ts", "vitest.config.ts" ]
}
